<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CHART :: TOP MUSIC & PLAYLIST</title>
    <style>
        :root {
            --bg-dark: #121212;
            --card-bg: #181818;
            --card-hover: #282828;
            --primary: #1ed760;
            --text-main: #ffffff;
            --text-sub: #b3b3b3;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            padding-bottom: 120px;
        }

        header {
            padding: 2rem 1.5rem;
            background: linear-gradient(180deg, #222 0%, var(--bg-dark) 100%);
            text-align: center;
        }

        header h1 { font-size: 2rem; color: var(--primary); margin-bottom: 0.5rem; }

        /* Category Tabs */
        .tabs {
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            padding: 1rem;
            flex-wrap: wrap;
            background: #000;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .tab-btn {
            background: #222;
            color: var(--text-sub);
            border: none;
            padding: 0.6rem 1.2rem;
            border-radius: 20px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.2s;
        }

        .tab-btn:hover, .tab-btn.active {
            background: var(--primary);
            color: #000;
        }

        .container {
            max-width: 900px;
            margin: 1.5rem auto;
            padding: 0 1rem;
        }

        /* Chart Table List */
        .chart-list { display: flex; flex-direction: column; gap: 0.5rem; }

        .chart-item {
            display: flex;
            align-items: center;
            background: var(--card-bg);
            padding: 0.8rem 1rem;
            border-radius: 8px;
            transition: background 0.2s;
            cursor: pointer;
        }

        .chart-item:hover { background: var(--card-hover); }

        .rank { font-size: 1.2rem; font-weight: bold; width: 40px; color: var(--primary); text-align: center; }
        .album-icon { font-size: 1.8rem; margin-right: 1rem; }
        .info { flex: 1; }
        .title { font-weight: bold; font-size: 1rem; margin-bottom: 0.2rem; }
        .artist { color: var(--text-sub); font-size: 0.85rem; }

        .actions { display: flex; gap: 0.8rem; align-items: center; }
        .like-btn {
            background: none;
            border: none;
            color: #666;
            font-size: 1.3rem;
            cursor: pointer;
            transition: transform 0.2s;
        }

        .like-btn.active { color: #e11d48; }
        .like-btn:hover { transform: scale(1.2); }

        /* Bottom Player Bar */
        .player-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #000;
            border-top: 1px solid #333;
            padding: 0.8rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            z-index: 100;
        }

        .player-info { display: flex; align-items: center; gap: 1rem; }
        .player-video { width: 160px; height: 90px; border-radius: 6px; overflow: hidden; }
        .player-video iframe { width: 100%; height: 100%; border: none; }
    </style>
</head>
<body>

    <header>
        <h1>🎧 TOP MUSIC CHART</h1>
        <p>실시간 인기차트 & 나만의 플레이리스트</p>
    </header>

    <!-- 카테고리 탭 -->
    <div class="tabs">
        <button class="tab-btn active" onclick="switchCategory('top')">🔥 종합 TOP</button>
        <button class="tab-btn" onclick="switchCategory('hiphop')">🎤 힙합</button>
        <button class="tab-btn" onclick="switchCategory('ballad')">🌧️ 발라드</button>
        <button class="tab-btn" onclick="switchCategory('dance')">💃 댄스</button>
        <button class="tab-btn" onclick="switchCategory('karaoke')">🎤 노래방 인기</button>
        <button class="tab-btn" style="border: 1px solid var(--primary);" onclick="switchCategory('my')">❤️ 내 저장함</button>
    </div>

    <div class="container">
        <div class="chart-list" id="chartList">
            <!-- 자바스크립트로 동적 생성 -->
        </div>
    </div>

    <!-- 하단 재생 플레이어 바 -->
    <div class="player-bar">
        <div class="player-info">
            <div>
                <div class="title" id="nowTitle">곡을 선택해주세요</div>
                <div class="artist" id="nowArtist">실시간 유튜브 재생</div>
            </div>
        </div>
        <div class="player-video">
            <iframe id="ytPlayer" src="" allow="autoplay"></iframe>
        </div>
    </div>

    <script>
        // 노래 데이터베이스 (유튜브 비디오 ID 연동)
        const musicData = [
            { id: '1', rank: 1, category: 'hiphop', title: 'SPOT! (feat. JENNIE)', artist: '지코 (ZICO)', ytId: 'm4_9_xQ_f14', emoji: '🎧' },
            { id: '2', rank: 2, category: 'dance', title: 'Supernova', artist: 'aespa', ytId: 'phuiAIQRUQs', emoji: '⚡' },
            { id: '3', rank: 3, category: 'ballad', title: '그대를 내 품에', artist: '황치열', ytId: '3uA0Z31T32U', emoji: '🌧️' },
            { id: '4', rank: 4, category: 'karaoke', title: '응급실', artist: 'izi', ytId: 'W3_rI5S2bJ4', emoji: '🎤' },
            { id: '5', rank: 5, category: 'hiphop', title: 'TIMED OUT', artist: '창모', ytId: '3G4O9N4p4n8', emoji: '🔥' },
            { id: '6', rank: 6, category: 'dance', title: 'How Sweet', artist: 'NewJeans', ytId: 'Q3K0TOvTOno', emoji: '🥐' }
        ];

        let myPlaylist = JSON.parse(localStorage.getItem('myPlaylist') || '[]');
        let currentCategory = 'top';

        function renderChart(items) {
            const listEl = document.getElementById('chartList');
            listEl.innerHTML = '';

            if (items.length === 0) {
                listEl.innerHTML = '<div style="text-align:center; padding:3rem; color:#888;">저장된 노래가 없습니다.</div>';
                return;
            }

            items.forEach((song, idx) => {
                const isLiked = myPlaylist.includes(song.id);
                const item = document.createElement('div');
                item.className = 'chart-item';
                item.innerHTML = `
                    <div class="rank">${idx + 1}</div>
                    <div class="album-icon">${song.emoji}</div>
                    <div class="info" onclick="playSong('${song.title}', '${song.artist}', '${song.ytId}')">
                        <div class="title">${song.title}</div>
                        <div class="artist">${song.artist}</div>
                    </div>
                    <div class="actions">
                        <button class="like-btn ${isLiked ? 'active' : ''}" onclick="toggleLike(event, '${song.id}')">♥</button>
                    </div>
                `;
                listEl.appendChild(item);
            });
        }

        function playSong(title, artist, ytId) {
            document.getElementById('nowTitle').innerText = title;
            document.getElementById('nowArtist').innerText = artist;
            document.getElementById('ytPlayer').src = `https://www.youtube.com/embed/${ytId}?autoplay=1`;
        }

        function toggleLike(event, id) {
            event.stopPropagation();
            if (myPlaylist.includes(id)) {
                myPlaylist = myPlaylist.filter(item => item !== id);
            } else {
                myPlaylist.push(id);
            }
            localStorage.setItem('myPlaylist', JSON.stringify(myPlaylist));
            
            // Re-render
            if (currentCategory === 'my') {
                const likedSongs = musicData.filter(s => myPlaylist.includes(s.id));
                renderChart(likedSongs);
            } else {
                switchCategory(currentCategory);
            }
        }

        function switchCategory(cat) {
            currentCategory = cat;
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            if (cat === 'top') {
                renderChart(musicData);
            } else if (cat === 'my') {
                const likedSongs = musicData.filter(s => myPlaylist.includes(s.id));
                renderChart(likedSongs);
            } else {
                const filtered = musicData.filter(s => s.category === cat);
                renderChart(filtered);
            }
        }

        // 초기 실행
        renderChart(musicData);
    </script>
</body>
</html>
